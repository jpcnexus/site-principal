# NEXUS JPC — configuração Apache/LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.html

# Página 404 personalizada
ErrorDocument 404 /404.html

# Bloqueia acesso público aos arquivos-fonte do gerador
RedirectMatch 404 ^/(src|scripts)(/.*)?$
RedirectMatch 404 ^/\.git
<FilesMatch "(^\.|\.md$|\.mjs$|package\.json$)">
  Require all denied
</FilesMatch>

# Tipos de arquivo
AddType image/webp .webp
AddType image/svg+xml .svg

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml text/plain application/ld+json
</IfModule>

# Cache: HTML sempre revalidado; CSS/JS versionados e imagens com cache longo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Segurança básica
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Redirecionamento para HTTPS (descomente depois de confirmar que o SSL está ativo na Hostinger)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
